# Proprietary Adobe binaries/resources — reference only, never commit
/source/

# Rust build artifacts (future workspace)
/target
# fuzz/ is its own workspace (stable driver + nightly libfuzzer targets)
/fuzz/target
/fuzz/artifacts
/fuzz/coverage
/fuzz/corpus

# Runtime scratch (per AGENTS.md: plan/ and log/ are untracked handoff state)
/plan/
/log/
# Probe artifacts + throwaway helper scripts (headless-probe PNGs, gfwait*.py)
/.gitignore-scratch/
# Real Fireworks files never enter the repo; generated fixtures/ and
# MANIFEST.tsv are tracked.
/corpus/incoming/

# trunk build output
web/dist/

# release staging (xtask dist)
/dist/

# wrangler local state
/.wrangler/
lcov.info

# Session scratch: CS6 reference screenshots + session notes (Adobe-derived, never commit)
/temp/

# llvm-cov raw profile files written by `xtask coverage` on every gate run
*.profraw

# Session scratch: throwaway helper scripts and probe artifacts
/.claude/scratch/
